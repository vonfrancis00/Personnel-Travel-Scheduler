# Google Cloud OAuth 2.0 Web client ID (safe to expose in browser code)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Use "primary" for the signed-in user's main calendar, or a shared calendar ID.
VITE_GOOGLE_CALENDAR_ID=primary

# Alternative without Google Cloud Console: deploy google-apps-script/Code.gs
# as an Apps Script web app, then use these values instead of the OAuth client ID.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_GOOGLE_APPS_SCRIPT_ACCESS_CODE=replace-with-a-long-random-code
